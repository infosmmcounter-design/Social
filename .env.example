# Required on Vercel for persistent data (Neon free Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# TronGrid free API key. Used only on the server to read incoming USDT TRC20 transfers.
# Create one at https://www.trongrid.io/ (free). Never put this in frontend code.
TRONGRID_API_KEY=

# Secret for /api/cron/crypto. Use a long random string.
# Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional. Leave empty to use the free public BNB Smart Chain RPC.
# BSC_RPC_URL=https://bsc-dataseed.binance.org
