# Required on Vercel for persistent data (Neon free Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public site address. Verification links use this.
APP_URL=https://your-domain.com

# Mailbox for signup verification. GoDaddy email example:
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=hello@your-domain.com
# SMTP_PASS=the mailbox password
# SMTP_FROM=SocialsFlip <hello@your-domain.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
